// Banco PostgreSQL (Supabase em produção).
// DATABASE_URL: conexão pelo pooler (porta 6543), usada pelo sistema.
// DIRECT_URL: conexão de sessão (porta 5432), usada para aplicar migrações.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Cada autoescola que usa o sistema. Os dados de uma não são vistos pelas outras:
// usuários, alunos, instrutores e veículos pertencem a uma autoescola, e as demais
// tabelas pertencem a ela por meio deles (ver src/lib/db.ts).
model Autoescola {
  id           Int           @id @default(autoincrement())
  nome         String
  ativo        Boolean       @default(true)
  criadoEm     DateTime      @default(now())
  usuarios     Usuario[]
  alunos       Aluno[]
  instrutores  Instrutor[]
  veiculos     Veiculo[]
  despesas     Despesa[]
  feriados     Feriado[]
  configuracao Configuracao?
}

// Responsáveis da autoescola que acessam o sistema.
// papel: "admin" | "secretaria". `superadmin` é o dono da plataforma, que cadastra autoescolas.
model Usuario {
  id           Int        @id @default(autoincrement())
  autoescolaId Int
  autoescola   Autoescola @relation(fields: [autoescolaId], references: [id])
  nome         String
  email        String     @unique
  senhaHash    String
  papel        String     @default("secretaria")
  superadmin   Boolean    @default(false)
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now())

  @@index([autoescolaId])
}

// status: "ativo" | "concluido" | "desistente"
model Aluno {
  id             Int         @id @default(autoincrement())
  autoescolaId   Int
  autoescola     Autoescola  @relation(fields: [autoescolaId], references: [id])
  nome           String
  cpf            String
  telefone       String?
  telefone2      String?
  email          String?
  nascimento     DateTime?
  endereco       String?
  // Dados da ficha de cadastro (todos opcionais).
  numero         String?
  bairro         String?
  pai            String?
  mae            String?
  rg             String?
  rgOrgao        String?
  rgUf           String?
  rgExpedicao    DateTime?
  renach         String?
  registroCnh    String?
  naturalidade   String?
  localAtividade String?
  biometriaEm    DateTime?
  categoria      String
  status         String      @default("ativo")
  obs            String?
  // Foto em data URL (JPEG reduzido no navegador). fotoEm muda a cada troca e
  // serve de versão no endereço da imagem (cache do navegador).
  foto           String?
  fotoEm         DateTime?
  // Conta gov.br (o login é o CPF). Só para consulta da autoescola: não sai em
  // contrato, ficha nem relatório. A senha fica criptografada (src/lib/govbr.ts).
  govbrSenha     String?
  govbrNivel     String?
  govbrObs       String?
  criadoEm       DateTime    @default(now())
  matriculas     Matricula[]

  @@unique([autoescolaId, cpf])
}

model Instrutor {
  id           Int        @id @default(autoincrement())
  autoescolaId Int
  autoescola   Autoescola @relation(fields: [autoescolaId], references: [id])
  nome         String
  telefone     String?
  categorias   String
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now())
  aulas        Aula[]
  etapas       Etapa[]

  @@index([autoescolaId])
}

model Veiculo {
  id                   Int          @id @default(autoincrement())
  autoescolaId         Int
  autoescola           Autoescola   @relation(fields: [autoescolaId], references: [id])
  placa                String
  modelo               String
  categoria            String
  // Calendário do licenciamento: "leve" (carros, motos, ônibus) ou "pesado" (caminhões e tratores).
  tipoLicenciamento    String       @default("leve")
  // Último ano em que o licenciamento foi pago (o aviso some até o ano seguinte).
  licenciamentoPagoAno Int?
  ativo                Boolean      @default(true)
  criadoEm             DateTime     @default(now())
  aulas                Aula[]
  manutencoes          Manutencao[]
  despesas             Despesa[]
  etapas               Etapa[]

  @@unique([autoescolaId, placa])
}

// Pacote contratado pelo aluno. Valores em centavos.
model Matricula {
  id                 Int       @id @default(autoincrement())
  alunoId            Int
  aluno              Aluno     @relation(fields: [alunoId], references: [id])
  categoria          String
  qtdPraticas        Int
  // Aulas práticas por categoria, ex.: {"A": 10, "B": 20} (a soma é qtdPraticas).
  praticasPorCategoria Json?
  qtdTeoricas        Int
  valorTotalCentavos Int
  // Juros ao mês em centésimos de ponto percentual (199 = 1,99% a.m.).
  jurosMesBp         Int       @default(0)
  // Como o valor (ou o restante, se houve entrada) é pago:
  // "carne" (parcelado pela autoescola) | "cartao" | "pix" | "dinheiro" (pago na hora, já quitado)
  formaPagamento     String    @default("carne")
  // Entrada paga na matrícula (fica na parcela de número 0).
  entradaCentavos    Int       @default(0)
  entradaForma       String?
  // "primeira" | "adicao" | "mudanca" | "reabilitacao" (ver src/lib/etapas.ts)
  tipoProcesso       String    @default("primeira")
  // Curso teórico: "autoescola" (aulas pagas) | "online" (grátis no app CNH do Brasil) | "dispensado"
  cursoTeorico       String    @default("autoescola")
  data               DateTime  @default(now())
  aulas              Aula[]
  parcelas           Parcela[]
  etapas             Etapa[]
}

// Exames e taxas externas do processo de habilitação (médico, psicológico,
// toxicológico, provas do Detran, emissão da CNH...). Cada item pode ser pago
// direto pelo aluno ("aluno") ou cobrado pela autoescola ("autoescola").
model Etapa {
  id            Int        @id @default(autoincrement())
  matriculaId   Int
  matricula     Matricula  @relation(fields: [matriculaId], references: [id])
  // Ver TIPOS_ETAPA em src/lib/etapas.ts
  tipo          String
  descricao     String
  // Categoria do exame prático (A, B, C, D ou E).
  categoria     String?
  ordem         Int        @default(0)
  // Dia agendado ou realizado.
  data          DateTime?
  // Exame do Detran: horário, local e, no prático, o veículo e o instrutor que
  // acompanha (ficam ocupados na agenda nesse horário).
  hora          String?
  local         String?
  veiculoId     Int?
  veiculo       Veiculo?   @relation(fields: [veiculoId], references: [id])
  instrutorId   Int?
  instrutor     Instrutor? @relation(fields: [instrutorId], references: [id])
  // "ok" (aprovado/apto/concluído) | "falhou" (reprovado/inapto) | null (ainda não)
  resultado     String?
  valorCentavos Int?
  cobranca      String     @default("aluno")
  pagoEm        DateTime?
  forma         String?
  obs           String?
  criadoEm      DateTime   @default(now())

  @@index([matriculaId])
  @@index([data])
}

// tipo: "pratica" | "teorica"
// status: "agendada" | "presente" | "faltou" | "cancelada"
model Aula {
  id          Int        @id @default(autoincrement())
  matriculaId Int
  matricula   Matricula  @relation(fields: [matriculaId], references: [id])
  instrutorId Int?
  instrutor   Instrutor? @relation(fields: [instrutorId], references: [id])
  veiculoId   Int?
  veiculo     Veiculo?   @relation(fields: [veiculoId], references: [id])
  tipo        String
  // Categoria da aula prática (a do veículo): conta no saldo daquela categoria.
  categoria   String?
  dataHora    DateTime
  duracaoMin  Int        @default(50)
  status      String     @default("agendada")
  obs         String?

  @@index([dataHora])
}

// forma: "dinheiro" | "pix" | "cartao" | "boleto"
model Parcela {
  id                Int       @id @default(autoincrement())
  matriculaId       Int
  matricula         Matricula @relation(fields: [matriculaId], references: [id])
  numero            Int
  valorCentavos     Int
  vencimento        DateTime
  pagoEm            DateTime?
  valorPagoCentavos Int?
  forma             String?
  obs               String?

  @@index([vencimento])
}

// Manutenções e lembretes de cada veículo.
model Manutencao {
  id                Int       @id @default(autoincrement())
  veiculoId         Int
  veiculo           Veiculo   @relation(fields: [veiculoId], references: [id])
  descricao         String
  data              DateTime?
  km                Int?
  valorCentavos     Int?
  lembrarEm         DateTime?
  lembreteConcluido Boolean   @default(false)
  obs               String?
  criadoEm          DateTime  @default(now())

  @@index([lembrarEm])
}

// Dados de cada autoescola (id = id da autoescola), usados no menu, recibos e carnês.
model Configuracao {
  id                      Int        @id
  autoescola              Autoescola @relation(fields: [id], references: [id])
  nome                    String     @default("Minha Autoescola")
  razaoSocial             String?
  cnpj                    String?
  endereco                String?
  bairro                  String?
  cidade                  String?
  uf                      String?
  cep                     String?
  telefone                String?
  whatsapp                String?
  email                   String?
  chavePix                String?
  // Texto impresso no rodapé do carnê (ex.: multa após o vencimento).
  avisoCarne              String?
  // Orientações impressas no guia do aluno entregue na matrícula.
  orientacoesAluno        String?
  // Expediente usado para oferecer os horários de aula (HH:MM) e o intervalo entre eles.
  horaInicio              String     @default("07:00")
  horaFim                 String     @default("20:00")
  intervaloMin            Int        @default(60)
  // Logotipo em data URL (imagem já reduzida no navegador).
  logo                    String?
  // Onde saem recibos e carnê: "a4" (impressora comum) ou "termica" (bobina 80 mm).
  impressoraRecibo        String     @default("a4")
  // Modelo de contrato (.docx) com marcações {{campo}} preenchidas com os dados do aluno.
  contratoArquivo         Bytes?
  contratoNome            String?
  contratoEm              DateTime?
  // Valor e quem paga cada exame/taxa, usados ao criar a matrícula:
  // { [tipo]: { valor: centavos, cobranca: "aluno" | "autoescola" } }
  taxasPadrao             Json?
  // Mês de vencimento do licenciamento por final de placa (padrão: SP).
  // { leve: { "1": 7, ... "0": 12 }, pesado: { ... } }
  calendarioLicenciamento Json?
  // Feriados automáticos (nacionais/estaduais) que a autoescola não segue: lista de chaves.
  feriadosIgnorados       Json?
  // Cor principal do sistema para esta autoescola (ver PALETAS em src/lib/paletas.ts).
  paleta                  String     @default("azul")
}

// Despesas da autoescola: folha, vales, abastecimento, contas, retiradas...
// Fica "a pagar" até receber a data de pagamento.
model Despesa {
  id            Int        @id @default(autoincrement())
  autoescolaId  Int
  autoescola    Autoescola @relation(fields: [autoescolaId], references: [id])
  // Ver CATEGORIAS_DESPESA em src/lib/despesas.ts
  categoria     String
  descricao     String
  // Para quem foi pago (funcionário, posto, empresa...).
  favorecido    String?
  valorCentavos Int
  vencimento    DateTime
  pagoEm        DateTime?
  forma         String?
  // Abastecimento: veículo, litros (em centésimos: 3550 = 35,50 L) e km.
  veiculoId     Int?
  veiculo       Veiculo?   @relation(fields: [veiculoId], references: [id])
  litrosCent    Int?
  km            Int?
  obs           String?
  criadoEm      DateTime   @default(now())

  @@index([autoescolaId, vencimento])
  @@index([autoescolaId, pagoEm])
}

// Feriados cadastrados pela autoescola (municipais, recessos...). `anual`: repete
// todo ano no mesmo dia e mês. Os nacionais e estaduais são calculados no código.
model Feriado {
  id           Int        @id @default(autoincrement())
  autoescolaId Int
  autoescola   Autoescola @relation(fields: [autoescolaId], references: [id])
  data         DateTime
  nome         String
  anual        Boolean    @default(true)
  criadoEm     DateTime   @default(now())

  @@index([autoescolaId])
}
