// Banco PostgreSQL (Supabase em produção).
// DATABASE_URL: conexão pelo pooler (porta 6543), usada pelo sistema.
// DIRECT_URL: conexão de sessão (porta 5432), usada para aplicar migrações.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Cada autoescola que usa o sistema. Os dados de uma não são vistos pelas outras:
// usuários, alunos, instrutores e veículos pertencem a uma autoescola, e as demais
// tabelas pertencem a ela por meio deles (ver src/lib/db.ts).
model Autoescola {
  id           Int           @id @default(autoincrement())
  nome         String
  ativo        Boolean       @default(true)
  criadoEm     DateTime      @default(now())
  usuarios     Usuario[]
  alunos       Aluno[]
  instrutores  Instrutor[]
  veiculos     Veiculo[]
  despesas     Despesa[]
  configuracao Configuracao?
}

// Responsáveis da autoescola que acessam o sistema.
// papel: "admin" | "secretaria". `superadmin` é o dono da plataforma, que cadastra autoescolas.
model Usuario {
  id           Int        @id @default(autoincrement())
  autoescolaId Int
  autoescola   Autoescola @relation(fields: [autoescolaId], references: [id])
  nome         String
  email        String     @unique
  senhaHash    String
  papel        String     @default("secretaria")
  superadmin   Boolean    @default(false)
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now())

  @@index([autoescolaId])
}

// status: "ativo" | "concluido" | "desistente"
model Aluno {
  id           Int         @id @default(autoincrement())
  autoescolaId Int
  autoescola   Autoescola  @relation(fields: [autoescolaId], references: [id])
  nome         String
  cpf          String
  telefone     String?
  email        String?
  nascimento   DateTime?
  endereco     String?
  categoria    String
  status       String      @default("ativo")
  obs          String?
  criadoEm     DateTime    @default(now())
  matriculas   Matricula[]

  @@unique([autoescolaId, cpf])
}

model Instrutor {
  id           Int        @id @default(autoincrement())
  autoescolaId Int
  autoescola   Autoescola @relation(fields: [autoescolaId], references: [id])
  nome         String
  telefone     String?
  categorias   String
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now())
  aulas        Aula[]

  @@index([autoescolaId])
}

model Veiculo {
  id           Int          @id @default(autoincrement())
  autoescolaId Int
  autoescola   Autoescola   @relation(fields: [autoescolaId], references: [id])
  placa        String
  modelo       String
  categoria    String
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())
  aulas        Aula[]
  manutencoes  Manutencao[]
  despesas     Despesa[]

  @@unique([autoescolaId, placa])
}

// Pacote contratado pelo aluno. Valores em centavos.
model Matricula {
  id                 Int       @id @default(autoincrement())
  alunoId            Int
  aluno              Aluno     @relation(fields: [alunoId], references: [id])
  categoria          String
  qtdPraticas        Int
  qtdTeoricas        Int
  valorTotalCentavos Int
  // Juros ao mês em centésimos de ponto percentual (199 = 1,99% a.m.).
  jurosMesBp         Int       @default(0)
  // "carne" (parcelado pela autoescola) | "cartao" | "pix" | "dinheiro" (à vista, já quitado)
  formaPagamento     String    @default("carne")
  data               DateTime  @default(now())
  aulas              Aula[]
  parcelas           Parcela[]
}

// tipo: "pratica" | "teorica"
// status: "agendada" | "presente" | "faltou" | "cancelada"
model Aula {
  id          Int        @id @default(autoincrement())
  matriculaId Int
  matricula   Matricula  @relation(fields: [matriculaId], references: [id])
  instrutorId Int?
  instrutor   Instrutor? @relation(fields: [instrutorId], references: [id])
  veiculoId   Int?
  veiculo     Veiculo?   @relation(fields: [veiculoId], references: [id])
  tipo        String
  dataHora    DateTime
  duracaoMin  Int        @default(50)
  status      String     @default("agendada")
  obs         String?

  @@index([dataHora])
}

// forma: "dinheiro" | "pix" | "cartao" | "boleto"
model Parcela {
  id                Int       @id @default(autoincrement())
  matriculaId       Int
  matricula         Matricula @relation(fields: [matriculaId], references: [id])
  numero            Int
  valorCentavos     Int
  vencimento        DateTime
  pagoEm            DateTime?
  valorPagoCentavos Int?
  forma             String?
  obs               String?

  @@index([vencimento])
}

// Manutenções e lembretes de cada veículo.
model Manutencao {
  id                Int       @id @default(autoincrement())
  veiculoId         Int
  veiculo           Veiculo   @relation(fields: [veiculoId], references: [id])
  descricao         String
  data              DateTime?
  km                Int?
  valorCentavos     Int?
  lembrarEm         DateTime?
  lembreteConcluido Boolean   @default(false)
  obs               String?
  criadoEm          DateTime  @default(now())

  @@index([lembrarEm])
}

// Dados de cada autoescola (id = id da autoescola), usados no menu, recibos e carnês.
model Configuracao {
  id               Int        @id
  autoescola       Autoescola @relation(fields: [id], references: [id])
  nome             String     @default("Minha Autoescola")
  razaoSocial      String?
  cnpj             String?
  endereco         String?
  bairro           String?
  cidade           String?
  uf               String?
  cep              String?
  telefone         String?
  whatsapp         String?
  email            String?
  chavePix         String?
  // Texto impresso no rodapé do carnê (ex.: multa após o vencimento).
  avisoCarne       String?
  // Orientações impressas no guia do aluno entregue na matrícula.
  orientacoesAluno String?
  // Expediente usado para oferecer os horários de aula (HH:MM) e o intervalo entre eles.
  horaInicio       String     @default("07:00")
  horaFim          String     @default("20:00")
  intervaloMin     Int        @default(60)
  // Logotipo em data URL (imagem já reduzida no navegador).
  logo             String?
}

// Despesas da autoescola: folha, vales, abastecimento, contas, retiradas...
// Fica "a pagar" até receber a data de pagamento.
model Despesa {
  id            Int        @id @default(autoincrement())
  autoescolaId  Int
  autoescola    Autoescola @relation(fields: [autoescolaId], references: [id])
  // Ver CATEGORIAS_DESPESA em src/lib/despesas.ts
  categoria     String
  descricao     String
  // Para quem foi pago (funcionário, posto, empresa...).
  favorecido    String?
  valorCentavos Int
  vencimento    DateTime
  pagoEm        DateTime?
  forma         String?
  // Abastecimento: veículo, litros (em centésimos: 3550 = 35,50 L) e km.
  veiculoId     Int?
  veiculo       Veiculo?   @relation(fields: [veiculoId], references: [id])
  litrosCent    Int?
  km            Int?
  obs           String?
  criadoEm      DateTime   @default(now())

  @@index([autoescolaId, vencimento])
  @@index([autoescolaId, pagoEm])
}
